{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel:build",
  "outputDirectory": "artifacts/soso-store/dist/public",
  "routes": [
    {
      "src": "/api",
      "dest": "/api/handler.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/handler.js?__soso_path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}