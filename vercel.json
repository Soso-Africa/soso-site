{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel:build",
  "outputDirectory": "artifacts/soso-store/dist/public",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api",
      "dest": "/api/handler.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/handler.js?__soso_path=$1"
    },
    {
      "src": "/(.*)",
      "has": [
        { "type": "host", "value": "www.shopsoso.co" }
      ],
      "headers": {
        "Location": "https://shopsoso.co/$1"
      },
      "status": 308
    },
    {
      "src": "/(.*)",
      "has": [
        { "type": "host", "value": "(?<deployment>.+)\\.vercel\\.app" }
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}